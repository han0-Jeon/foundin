# ── LLM 러너 선택: solar(기본) | claude-code | codex ─────────────
FOUNDIN_RUNNER=solar

# Solar Open 2 (Upstage Private Beta, ~2026-08-01)
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-open2
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# 8/1 이후 구독 러너(선택): claude CLI / codex CLI 가 OAuth 로그인돼 있어야 함
# CLAUDE_CODE_BIN=claude
# CODEX_BIN=codex

# worker 모드 전용 (foundin.kr 편집국 연동)
# FOUNDIN_BASE_URL=https://foundin.kr
# BRIEF_WORKER_SECRET=
# WORKER_CONCURRENCY=3
