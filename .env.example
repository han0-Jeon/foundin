# ── 필수: 이 한 줄만 채우면 npm run demo 가 돕니다 ──────────────
# 키 발급: https://console.upstage.ai
UPSTAGE_API_KEY=

# ── 아래는 전부 선택 (기본값으로 동작합니다) ────────────────────
FOUNDIN_RUNNER=solar

# 모델 (Upstage 공지 2026-08-03, 전환 완료 2026-08-04)
#   solar-pro4   현행. 정식 출시 전까지 무료 체험으로 열려 있다
#   solar-open2  구 모델. 8/4(화) 자정에 alias 삭제 — 더 이상 호출되지 않는다
# 비워 두면 solar-pro4 로 동작한다. API Key·엔드포인트는 두 모델이 동일했다.
UPSTAGE_MODEL=solar-pro4
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# 추론 강도 — low | medium | high | off (기본 off)
# ⚠ pro4 는 8/6 리비전(solar-pro4-260806)부터 기본이 "추론 끄기"다. 이 값을 주지 않으면
#   reasoning_tokens=0 으로, 생각하지 않고 바로 답을 쓴다 (2026-08-11 실측).
#   긴 공고 정독 품질을 올리려면 켜되, 생각도 completion 토큰이라 시간·비용이 함께 는다.
#   pro4 계열이 아닌 모델은 이 파라미터를 거부하므로, 그때는 자동으로 꺼진 채 계속 돈다.
UPSTAGE_REASONING_EFFORT=off

# 2회 교차 검증 — 1(기본, 끔) | 2
# 같은 원문을 독립 2회 추출해 **두 번 다 같은 값만** 남긴다. 갈리는 값은 null 로 내려
# "원문 확인 필요"로 표기된다 (fail-closed — 둘 중 하나를 고르지 않는다).
# 인용 대조가 못 잡는 오류(실존 문장을 엉뚱한 필드·숫자에 붙이기)를 재현성으로 거른다.
# 지우는 건 값(개요·자격 스칼라·배열)뿐이고, 요건·서류 같은 **항목 리스트는 지우지 않는다** —
# 표현 차이만으로 브리프가 텅 비기 때문이다(실측). 재현 안 된 항목은 unstable_items 로 기록만.
# 토큰·시간이 대략 2배. 결과는 brief.verification.cross_check 에 남는다.
FOUNDIN_CROSS_CHECK=1

# worker 모드 전용 (foundin.kr 연동)
# FOUNDIN_BASE_URL=https://foundin.kr
# BRIEF_WORKER_SECRET=
# 놀고 있을 때 다시 물어보는 간격(ms). 미설정 시 300000(5분), 최소 10000.
# 이건 **폴백**이다 — 새 잡은 Realtime 이 즉시 깨우고, 이 값은 Realtime 이 죽었을 때만 쓰인다.
# 낮추면 Vercel 함수 호출이 그대로 늘어난다: 20초였을 때 월 84만 회로 무료 한도의 84% 를 먹었다
# (2026-08-21 실측). 레인 수에 비례하므로 WORKER_CONCURRENCY 를 올릴 땐 같이 보라.
# WORKER_IDLE_POLL_MS=300000

# 베타 기간 WORKER_CONCURRENCY=6 권장 (user_submitted 잡 즉시성 확보, 미설정 시 3)
# WORKER_CONCURRENCY=6

# (선택) Realtime 즉시 깨우기 — 있으면 solar_briefs INSERT/needs_refresh 구독으로 픽업 20초→1초대.
# 없거나 구독 실패 시 20초 폴링으로 폴백(이중화).
# queued INSERT 이벤트는 RLS 때문에 service role 키가 필요 (anon 키는 재분석 깨우기만 수신).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# (선택·옵트인) 이미지 포스터 OCR — Upstage Document Parse (페이지당 과금, 콘솔 크레딧 확인 후 켤 것).
# 켜면: 이미지 첨부를 읽고, 본문이 빈약한 공고는 인라인 포스터 <img> 최대 2장을 OCR 한다.
# FOUNDIN_OCR=docparse
# FOUNDIN_OCR_MODEL=document-parse   # 순수 텍스트만 원하면 ocr (저가)
# FOUNDIN_OCR_KEY=                   # 미설정 시 UPSTAGE_API_KEY 사용. 베타 Solar 키의 용도 조항이
#                                    # 걸리면 일반 콘솔 키를 여기에 따로 넣는다

# (선택) 프리체크 Tier2 도메인 나이 검사용 KISA WHOIS 오픈API 키 (.kr 도메인 한정, 무료).
# 없으면 .kr 나이 검사는 생략하고 통과(fail-open). 그 외 TLD 는 RDAP(무키) 사용.
# KISA_WHOIS_KEY=
